# ==============================================================================
# Reve-Inspired AI Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or backend/.env) and update the values for your setup.
#
# NOTE: Never commit production credentials or live secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Runtime Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Project Metadata & API Configuration
PROJECT_NAME="Reve-Inspired AI Platform"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# Allowed CORS Origins (JSON array of strings)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# 2. Security & Authentication
# ------------------------------------------------------------------------------
# JWT Secret Key: Used for HS256 access and refresh token signing.
# Minimum 32 characters. In production, generate with: openssl rand -hex 32
JWT_SECRET_KEY=dev-insecure-secret-key-min-32-chars-long-reve-platform
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Shared Secret Token for Remote GPU Worker (Google Colab / External GPU)
# Authenticates inbound heartbeat, polling, and result submissions from the worker.
# Must match the X-Worker-Token header sent by the remote inference client.
# IMPORTANT: When tunneling to Google Colab, change this to a secure random token.
REVE_WORKER_SECRET_TOKEN=dev-reve-remote-worker-secret-token

# ------------------------------------------------------------------------------
# 3. Database Configuration
# ------------------------------------------------------------------------------
# SQLite (Default Zero-Cost Development Database):
DATABASE_URL=sqlite+aiosqlite:///C:/Users/austi/OneDrive/Desktop/Reve/backend/reve_dev.db

# PostgreSQL 16 (Production / Docker Compose Alternative):
# Uncomment the lines below to switch from SQLite to PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://reve:reve_password@localhost:5432/reve_db
# POSTGRES_USER=reve
# POSTGRES_PASSWORD=reve_password
# POSTGRES_DB=reve_db
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 4. Redis & Celery Message Queue
# ------------------------------------------------------------------------------
# Redis connection string (DB 0: application cache / rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Celery task broker (DB 1) and result backend (DB 2)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_CONCURRENCY=1

# ------------------------------------------------------------------------------
# 5. Object Storage (S3 / MinIO & Local Disk Fallback)
# ------------------------------------------------------------------------------
# MinIO / S3 endpoint configuration
# If MinIO is offline, the backend automatically uses local filesystem storage.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=reve-assets
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_USE_SSL=false
S3_PUBLIC_URL=http://localhost:9000/reve-assets

# ------------------------------------------------------------------------------
# 6. AI Inference Engine & Model Provider
# ------------------------------------------------------------------------------
# Active Generation Provider:
# - 'remote_worker'  : Ephemeral GPU worker (Google Colab T4 / Kaggle / Cloud GPU)
# - 'local_diffusers': In-process Diffusers pipeline (requires local PyTorch + GPU/CPU)
# - 'mock_test'      : Offline test provider producing valid deterministic PNGs
IMAGE_PROVIDER=remote_worker

# Primary Hugging Face Model Identifier
# For Google Colab T4 SD 1.5: runwayml/stable-diffusion-v1-5
# For local high-end GPU:      black-forest-labs/FLUX.1-dev or stabilityai/stable-diffusion-xl-base-1.0
HF_MODEL_ID=runwayml/stable-diffusion-v1-5
HF_FALLBACK_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0

# Allow CPU inference when CUDA is unavailable locally
ALLOW_CPU_INFERENCE=true

# Hugging Face Cache & Token (Optional, for downloading models locally)
HF_HOME=./ai-engine/.cache/huggingface
# HF_TOKEN=hf_your_huggingface_token_here

# ------------------------------------------------------------------------------
# 7. Local Inference Tuning (Used only when IMAGE_PROVIDER=local_diffusers)
# ------------------------------------------------------------------------------
DEVICE=cpu
PRECISION=fp32
QUANTIZATION=none

# Optional Services
# SENTRY_DSN=
# PROMETHEUS_METRICS_ENABLED=true
